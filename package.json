{
  "name": "near-xray",
  "version": "0.1.0",
  "private": true,
  "description": "Security scanner for NEAR smart contracts: bytecode capability scan + attack simulation in a local NEAR runtime. Web UI + MCP server over one shared core.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "tsx cli/scan.ts",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test core/scan.test.ts core/attacks.test.ts",
    "test:live": "XRAY_LIVE=1 tsx --test core/live.test.ts",
    "attack": "tsx cli/attack.ts",
    "build:runner": "cd runner && cargo build --release --locked",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "near-contract-parser": "1.0.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
